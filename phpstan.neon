includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon
  - phpstan-baseline.neon

parameters:
  level: 2
  paths: [ . ]
  # Generated artifacts and real-WordPress integration fixtures are checked separately.
  # Their standalone WordPress stubs must not override production API signatures.
  excludePaths: [ vendor/*, node_modules/*, .github/*, package/*, tests/fixtures/edition-wordpress-smoke.php, tests/price-labels-form-test.php ]

  stubFiles:
    - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    - stubs/elementor.php

  bootstrapFiles:
    - stubs/constants.php
