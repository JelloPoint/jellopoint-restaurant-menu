includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon
  - phpstan-baseline.neon

parameters:
  level: 2
  paths: [ . ]
  # Generated artifacts and the real-WordPress fixture are checked separately.
  excludePaths: [ vendor/*, node_modules/*, .github/*, package/*, tests/fixtures/edition-wordpress-smoke.php ]

  stubFiles:
    - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    - stubs/elementor.php

  bootstrapFiles:
    - stubs/constants.php
